<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 클라우드 백업 / 기기 간 전송. include 만 대상. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="data/myplan.json" />
        <include domain="file" path="data/sites.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="data/myplan.json" />
        <include domain="file" path="data/sites.json" />
    </device-transfer>
</data-extraction-rules>
